{
  "version": 1,
  "description": "Known places where the SheetJS oracle output (test/corpus/expected, .cache/expected) is wrong or differs on purpose from what effect-spreadsheet must return. Tests compare against SheetJS except at these locations, where they expect `correct`. expected.mjs copies the ids into each affected expected file as `knownQuirks`. r/c are 0-based.",
  "quirks": [
    {
      "id": "sylk-row-format-without-m-hidden",
      "file": "generated/sylk_row_format_no_m.slk",
      "sheet": "Sheet1",
      "field": "hiddenRows",
      "sheetjs": [
        0,
        2
      ],
      "correct": [
        2
      ],
      "note": "F;SDM6;R1 is a row-format record without M; SheetJS keeps Mval = 0 and marks row 0 hidden (bits/40_harb.js ~563). Only F;M0;R3 hides a row."
    },
    {
      "id": "csv-utf16be-not-decoded",
      "file": "generated/csv_utf16be.csv",
      "sheet": "Sheet1",
      "field": "cells",
      "sheetjs": "UTF-16BE bytes read as 8-bit text (cells like \"þÿ\\u0000a\\u0000\")",
      "correct": [
        [
          0,
          0,
          "a"
        ],
        [
          0,
          1,
          "b"
        ],
        [
          1,
          0,
          1
        ],
        [
          1,
          1,
          "é"
        ]
      ],
      "note": "SheetJS does not honour the FE FF BOM."
    },
    {
      "id": "csv-windows1252-read-as-latin1",
      "file": "generated/csv_windows1252.csv",
      "sheet": "Sheet1",
      "field": "cells",
      "sheetjs": [
        [
          2,
          0,
          "uro"
        ],
        [
          2,
          1,
          "q"
        ]
      ],
      "correct": [
        [
          2,
          0,
          "€uro"
        ],
        [
          2,
          1,
          "“q”"
        ]
      ],
      "note": "Bytes 0x80-0x9F are decoded as ISO-8859-1 (C1 control characters U+0080, U+0093, U+0094) instead of Windows-1252 (€, curly quotes)."
    },
    {
      "id": "xlsx-astral-char-ref-truncated",
      "file": "generated/strings.xlsx",
      "sheet": "Strings",
      "field": "cells",
      "sheetjs": [
        [
          0,
          2,
          "<tag> & \"quotes\"  é"
        ]
      ],
      "correct": [
        [
          0,
          2,
          "<tag> & \"quotes\" 🍣 é"
        ]
      ],
      "note": "The numeric character reference &#x1F363; (outside the BMP) is truncated to 16 bits: U+F363 instead of U+1F363 (🍣)."
    },
    {
      "id": "xlsx-x000d-escape-dropped",
      "file": "generated/strings.xlsx",
      "sheet": "Strings",
      "field": "cells",
      "sheetjs": [
        [
          0,
          3,
          "line1\nline2 A"
        ]
      ],
      "correct": [
        [
          0,
          3,
          "line1\r\nline2 A"
        ]
      ],
      "note": "_x000D_ decodes to CR; SheetJS drops it."
    },
    {
      "id": "csv-empty-quoted-field-no-cell",
      "file": "generated/csv_quoted_newlines.csv",
      "sheet": "Sheet1",
      "field": "cells",
      "sheetjs": "no cell at [5, 1]",
      "correct": [
        [
          5,
          1,
          ""
        ]
      ],
      "note": "Informational: an explicit empty quoted field (\"\") gives no cell in SheetJS; our reader may report an empty text cell there."
    },
    {
      "id": "declared-dimension-ignored",
      "file": "generated/huge_dimension.xml",
      "sheet": "Sheet1",
      "field": "ref",
      "sheetjs": "A1:B2",
      "correct": "A1:B2 (cells); declared dimension A1:XFD1048576",
      "note": "Informational: SheetJS's ref is the actual cell range for SpreadsheetML/SYLK, while it keeps the declared range for xlsx/xlsb/xls."
    },
    {
      "id": "declared-dimension-ignored",
      "file": "generated/huge_dimension.slk",
      "sheet": "Sheet1",
      "field": "ref",
      "sheetjs": "A1:B2",
      "correct": "A1:B2 (cells); declared dimension A1:XFD1048576",
      "note": "Informational, as above (B;Y1048576;X16384)."
    }
  ]
}
